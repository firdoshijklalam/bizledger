# §ENV-EXAMPLE: Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` file to git.

# §DATABASE: SQLite for local dev, PostgreSQL (Neon) for production.
# Local dev (SQLite):
DATABASE_URL=file:/home/z/my-project/db/custom.db

# §PRODUCTION-NEON: Use the POOLED connection string for Vercel serverless.
# The pooled endpoint has "-pooler" in the hostname and uses PgBouncer to
# reuse connections across serverless invocations. This prevents "too many
# clients" errors when multiple Vercel functions execute concurrently.
#
# Connection string format:
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&prepared_statements=false&connect_timeout=15&pool_timeout=30
#
# §PARAMETERS:
# - pgbouncer=true: tells Prisma to use PgBouncer mode (disables prepared statements)
# - prepared_statements=false: required for PgBouncer compatibility
# - connect_timeout=15: fail fast if Neon is cold-starting
# - pool_timeout=30: max time to wait for a connection from the pool
#
# §DIRECT-CONNECTION (for migrations only):
# Use the NON-pooled URL for `prisma migrate deploy` in the Vercel build:
# DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# This is because PgBouncer doesn't support DDL operations reliably.

# §AUTH-SECRET: Used for PIN hashing and biometric fingerprint hashing.
# Generate a random one: openssl rand -base64 32
# Set this in Vercel Environment Variables as well.
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string

# §RATE-LIMIT: Upstash Redis for distributed rate limiting (serverless-safe).
# Create a free database at upstash.com, then set these in Vercel:
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# §MARKETPLACE: Feature flag for public marketplace pages.
# Set to "true" ONLY when marketplace is production-ready (customer auth + payment webhook).
# Defaults to disabled (false) — marketplace pages are hidden.
NEXT_PUBLIC_ENABLE_MARKETPLACE=false
