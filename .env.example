# §ENV-EXAMPLE: Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` file to git.

# §DATABASE: SQLite for local dev, PostgreSQL (Neon) for production.
# Local dev (SQLite):
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Production (Neon PostgreSQL) — set this in Vercel Environment Variables:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&prepared_statements=false

# §AUTH-SECRET: Used for PIN hashing and biometric fingerprint hashing.
# Generate a random one: openssl rand -base64 32
# Set this in Vercel Environment Variables as well.
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
