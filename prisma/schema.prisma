// §STOCK-MOVEMENT: Tracks every stock change with type, quantity, and reference.
// This provides a complete audit trail for inventory — you can trace exactly
// when and why stock changed for any product.
model StockMovement {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  // §MOVEMENT-TYPE: SALE = stock out, PURCHASE = stock in,
  // SALE_RETURN = stock back in, PURCHASE_RETURN = stock back out,
  // ADJUSTMENT = manual correction
  type          String // sale | purchase | sale_return | purchase_return | adjustment
  quantity      Float // positive = stock in, negative = stock out
  balanceAfter  Float // stock level after this movement
  referenceId   String? // invoice ID, transaction ID, etc.
  referenceType String? // invoice | transaction | manual
  description   String?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, productId])
  @@index([businessId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  staffId     String?
  staffName   String
  action      String // create_invoice | modify_invoice | delete_invoice | khata_entry | restock | settings_change | data_export | staff_change | stock_adjust
  entityType  String // invoice | party | product | transaction | settings | staff | export
  entityId    String?
  description String
  // §AUDIT-METADATA: Optional JSON for additional context (amount, qty, old/new values)
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([businessId])
  @@index([staffId])
  // §AUDIT-INDEX: Query by entity type + time (e.g., "all invoice actions this week")
  @@index([businessId, entityType, createdAt])
}

model BusinessLink {
  id           String   @id @default(cuid())
  staffPhone   String
  businessId   String
  businessName String
  role         String   @default("sales")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([staffPhone])
}

// PRD Part 36 §1.2: Favorite Shop — auto-added when customer orders from a merchant's shared link
model FavoriteShop {
  id            String   @id @default(cuid())
  customerPhone String // customer identifier (phone or session)
  businessId    String
  businessName  String
  storeSlug     String
  addedAt       DateTime @default(now())

  @@unique([customerPhone, businessId])
  @@index([customerPhone])
}

// PRD Part 36 §2.1: Order split — global cart auto-split by shop
model OrderSplit {
  id               String    @id @default(cuid())
  parentOrderId    String // the original global cart order ID
  businessId       String
  businessName     String
  items            String // JSON array of items for this shop
  subtotal         Decimal   @default(0) @db.Decimal(18, 2)
  commissionPct    Float     @default(2)
  commissionAmount Decimal   @default(0) @db.Decimal(18, 2)
  merchantAmount   Decimal   @default(0) @db.Decimal(18, 2) // subtotal - commission
  status           String    @default("pending") // pending | confirmed | delivered | returned | cancelled
  deliveryOtp      String? // 4-digit OTP for delivery verification
  otpVerifiedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([parentOrderId])
  @@index([businessId])
  @@index([status])
}

// PRD Part 36 §2.2: Payment split — auto-settlement to merchant wallets
model PaymentSplit {
  id               String    @id @default(cuid())
  orderSplitId     String
  businessId       String
  totalAmount      Decimal   @default(0) @db.Decimal(18, 2)
  commissionPct    Float     @default(2)
  commissionAmount Decimal   @default(0) @db.Decimal(18, 2)
  merchantAmount   Decimal   @default(0) @db.Decimal(18, 2)
  settlementStatus String    @default("pending") // pending | settled | reversed
  settledAt        DateTime?
  reversedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([orderSplitId])
  @@index([businessId])
}

// PRD Part 36 §3.1: Return request — on-spot rejection with instant refund
model ReturnRequest {
  id            String    @id @default(cuid())
  orderSplitId  String
  customerPhone String?
  reason        String // damaged | wrong_product | quality_issue | other
  refundAmount  Decimal   @default(0) @db.Decimal(18, 2)
  refundStatus  String    @default("pending") // pending | refunded | denied
  refundedAt    DateTime?
  stockRestored Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([orderSplitId])
}

// PRD Part 36 §3.2: Customer trust score — anti-fraud return shield
model CustomerTrustScore {
  id                 String    @id @default(cuid())
  customerPhone      String    @unique
  trustScore         Float     @default(5.0) // 0-5 stars
  totalOrders        Int       @default(0)
  totalReturns       Int       @default(0)
  consecutiveReturns Int       @default(0)
  codLocked          Boolean   @default(false) // locked after 3 consecutive returns
  lastReturnAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([customerPhone])
}

// PRD Part 37 §3: Dual-profile switching — single phone number can be both customer and merchant
model UserProfile {
  id               String    @id @default(cuid())
  phone            String    @unique // same phone for customer + merchant
  role             String    @default("customer") // customer | merchant | dual
  merchantId       String? // linked Business ID if role includes merchant
  customerName     String?
  merchantName     String?
  // Security
  pinHash          String? // 4-6 digit master PIN hash
  pinEnabled       Boolean   @default(false)
  biometricEnabled Boolean   @default(false)
  // Profile metadata
  isSeller         Boolean   @default(false)
  sellerSince      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([phone])
}

// §CUSTOMER-BEHAVIOUR: Manually-rated interaction/service behaviour for a
// customer (Party). This is SEPARATE from the financial `creditTrustScore`
// (which is auto-computed from payment history). Customer Behaviour captures
// staff-assessed interaction qualities — e.g. "Respectful", "Aggressive",
// "Pays on time", "Frequently complains".
//
// §UNIQUENESS: One current behaviour row per (businessId, partyId). The
// upsert API enforces this; the @@unique constraint guarantees it at the DB
// level (defence in depth against races).
//
// §HISTORY: Every create/update appends an immutable snapshot to
// CustomerBehaviourHistory. History is append-only (no edits/deletes from
// the API surface in this step).
//
// §FIELDS:
//   - rating: enum string VERY_BAD | BAD | GOOD | BETTER | BEST
//   - tags:   JSON array string of lightweight tag labels (e.g.
//             ["Respectful","Regular customer"]). NOT a separate Tag/M2M
//             subsystem — kept simple by design.
//   - notes:  free-form staff note (optional)
//   - ratedBy: staff userId or "system" (free-form string, consistent with
//             existing PartyNote.author pattern)
model CustomerBehaviour {
  id        String   @id @default(cuid())
  businessId String
  partyId    String
  rating     String   // VERY_BAD | BAD | GOOD | BETTER | BEST
  tags       String?  // JSON array string: ["Respectful","Regular customer"]
  notes      String?
  ratedBy    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party      Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  history    CustomerBehaviourHistory[]

  @@unique([businessId, partyId]) // one current behaviour per party per business
  @@index([businessId])
  @@index([partyId])
  @@index([businessId, partyId])
}

// §CUSTOMER-BEHAVIOUR-HISTORY: Append-only audit trail of every behaviour
// state. Each row is an immutable snapshot of what the rating/tags/notes
// were at a point in time. The API never edits or deletes history rows.
//
// §BEHAVIOUR-FK-NULLABLE: behaviourId is NULLABLE + onDelete: SetNull (NOT
// Cascade). This preserves the APPEND-ONLY AUDIT invariant: if the current
// CustomerBehaviour row is deleted (e.g. a future "reset behaviour" feature,
// or party deletion cascading to CustomerBehaviour), the historical snapshot
// rows MUST survive — they are the audit trail. Deleting the current row
// sets history.behaviourId = NULL, but the snapshot data (rating, tags,
// notes, ratedBy, partyId, businessId) is fully retained.
// This follows the existing codebase convention: Transaction.party?
// @relation(... onDelete: SetNull) and Transaction.invoice? @relation(...
// onDelete: SetNull) both use SetNull for child rows that must survive
// parent deletion.
//
// §PARTY-DENORMALIZED: partyId is stored on the history row (denormalized
// from CustomerBehaviour.partyId) so history queries can be efficiently
// scoped by party without a join. The redundant FK relation to Party
// ensures cascade-delete consistency (see §PARTY-DELETE note below).
//
// §PARTY-DELETE: party Party @relation(... onDelete: Cascade) — deleting a
// Party DOES cascade-delete their behaviour history. This is a KNOWN
// consequence of the current minimal design (matching the CustomerBehaviour
// row's own party cascade). If the product later requires history to
// survive party deletion too (like AuditLog does), partyId should become
// nullable + SetNull in a follow-up step. That change is intentionally NOT
// made here to keep this correction minimal and focused on the behaviourId
// cascade invariant.
model CustomerBehaviourHistory {
  id           String   @id @default(cuid())
  businessId   String
  partyId      String
  behaviourId  String?  // NULLABLE — see §BEHAVIOUR-FK-NULLABLE above
  rating       String   // snapshot of CustomerBehaviour.rating at this time
  tags         String?  // snapshot
  notes        String?  // snapshot
  ratedBy      String?
  createdAt    DateTime @default(now())

  behaviour    CustomerBehaviour? @relation(fields: [behaviourId], references: [id], onDelete: SetNull)
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party        Party             @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([businessId, partyId, createdAt])
  @@index([behaviourId, createdAt])
  @@index([partyId, createdAt])
}

// §COMPLAINT-SEQUENCE: Per-business atomic counter for concurrency-safe complaint
// numbering (CMP-0001, CMP-0002, ...). Mirrors the InvoiceSequence pattern:
// upsert + { increment: 1 } inside a $transaction guarantees unique sequential
// numbers even under concurrent creation. One row per business.
model ComplaintSequence {
  id         String   @id @default(cuid())
  businessId String   @unique
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// §COMPLAINT: Independent customer complaint entity. NOT copied message text —
// a Complaint is a first-class record with its own lifecycle (status, priority,
// assignment, resolution, event history).
//
// §SOURCE-REFERENCE: sourceType + sourceId form an APPLICATION-LEVEL reference
// to the originating entity (MESSAGE, CALL, FEEDBACK, MANUAL, OTHER). There is
// NO polymorphic database FK — sourceId is a free-form String that the API
// validates at the application layer. This keeps the schema simple while allowing
// future source entities to be linked without schema changes.
//
// §PARTY-NULLABLE: partyId is nullable to support anonymous/walk-in complaints.
// onDelete: SetNull — deleting a Party does NOT delete their complaints (the
// complaint history survives, with partyId = NULL).
//
// §RELATED-INVOICE/PRODUCT: relatedInvoiceId + relatedProductId are nullable
// optional links. onDelete: SetNull on both — deleting an invoice/product does
// NOT delete linked complaints.
//
// §COMPLAINT-NUMBER: complaintNumber is unique per business (CMP-0001, CMP-0002).
// Generated atomically via ComplaintSequence inside a $transaction.
model Complaint {
  id               String    @id @default(cuid())
  businessId       String
  complaintNumber  String    // CMP-0001 (business-scoped sequence)
  partyId          String?   // nullable for anonymous/walk-in complaints
  sourceType       String    @default("MANUAL") // MESSAGE | CALL | FEEDBACK | MANUAL | OTHER
  sourceId         String?   // application-level ref to source entity (no DB FK)
  title            String
  description      String?
  status           String    @default("NEW") // NEW | IN_PROGRESS | WAITING | RESOLVED | CLOSED
  priority         String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  assignedTo       String?   // staff userId (free-form, like PartyNote.author)
  relatedInvoiceId String?
  relatedProductId String?
  resolution       String?
  internalNotes    String?   // JSON array of {note, author, createdAt}
  attachments      String?   // JSON array of {name, type, dataUrl}
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  resolvedAt       DateTime?

  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party            Party?    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  relatedInvoice   Invoice?  @relation(fields: [relatedInvoiceId], references: [id], onDelete: SetNull)
  relatedProduct   Product?  @relation(fields: [relatedProductId], references: [id], onDelete: SetNull)
  events           ComplaintEvent[]

  @@unique([businessId, complaintNumber]) // business-scoped uniqueness
  @@index([businessId, status])
  @@index([businessId, partyId])
  @@index([businessId, assignedTo])
  @@index([businessId, priority])
  @@index([businessId, createdAt])
}

// §COMPLAINT-EVENT: Append-only audit trail of every complaint state change.
// Each row is an immutable snapshot of a state transition (status change,
// priority change, assignment, comment, resolve, close). The API never edits
// or deletes history rows — only GET + POST (create) are exposed.
//
// §BEHAVIOUR-FK-NULLABLE: complaintId is NOT nullable + onDelete: Cascade
// (different from CustomerBehaviourHistory). Rationale: a complaint's event
// history is tightly coupled to the complaint's lifetime — if a complaint is
// deleted, its event history is no longer meaningful. The DELETE API uses a
// soft-archive approach (status=CLOSED) rather than hard-delete to preserve
// history. If hard-delete is ever needed, complaintId should become nullable
// + SetNull in a follow-up.
model ComplaintEvent {
  id           String   @id @default(cuid())
  businessId   String
  complaintId  String
  eventType    String   // CREATED | STATUS_CHANGE | PRIORITY_CHANGE | ASSIGN | COMMENT | RESOLVE | CLOSE
  fromValue    String?  // previous value (for STATUS_CHANGE, PRIORITY_CHANGE, ASSIGN)
  toValue      String?  // new value
  note         String?  // optional comment text (for COMMENT) or description
  actor        String?  // staff userId or "system"
  createdAt    DateTime @default(now())

  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@index([businessId, createdAt])
}

// §CUSTOMER-CHANNEL-IDENTITY: Maps a Party (customer) to an external channel
// identity (WhatsApp phone number, Telegram user ID, Instagram user ID, etc.).
//
// §UNIQUENESS: (businessId, channel, externalUserId) is unique — the same
// external identity cannot map to two different parties within the same
// business. Cross-business, the same external ID can exist (tenant isolation).
//
// §DEDUPLICATION: When a future webhook receives an inbound message from
// "whatsapp:919876543210", the system resolves the channel identity to the
// correct Party. If no identity exists, a new Party can be auto-created (or
// the message stored against an anonymous conversation until the customer is
// identified).
//
// §PHONE-NUMBER: For WhatsApp/SMS channels, externalUserId IS the phone number
// (E.164 format). For Telegram/Instagram, it's the platform's user ID.
model CustomerChannelIdentity {
  id              String   @id @default(cuid())
  businessId      String
  partyId         String
  channel         String   // whatsapp | telegram | messenger | instagram | sms | email | in_app
  externalUserId  String   // platform-specific user ID (phone for WhatsApp/SMS, user ID for others)
  externalUsername String? // @handle (Telegram/Instagram) or display name
  phoneNumber     String?  // E.164 phone (for whatsapp/sms channels — denormalized for convenience)
  displayName     String?  // how the customer appears on this channel
  metadata        String?  // JSON: platform-specific profile data
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party           Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([businessId, channel, externalUserId]) // one identity per channel per business
  @@index([businessId, partyId])
  @@index([businessId, channel])
  @@index([businessId, phoneNumber])
}

// §CONVERSATION: A thread of messages between a customer and the business on a
// specific channel. One customer can have multiple conversations (one per channel).
//
// §UNIQUENESS-STRATEGY:
//   - For external channels (whatsapp, telegram, etc.): externalId is the
//     provider's thread/chat ID. @@unique([businessId, channel, externalId])
//     prevents duplicate conversations for the same external thread.
//   - For in_app channel: externalId is NULL. A separate unique constraint
//     @@unique([businessId, partyId, channel]) ensures one in_app conversation
//     per customer per business. This works because partyId is NOT NULL for
//     in_app conversations (you need a known customer to have an in_app chat).
//
// §POSTGRESQL-NULL-SEMANTICS: PostgreSQL treats NULL values as distinct in
// unique indexes, so a NULL externalId does NOT conflict with another NULL.
// This is why we use TWO separate unique constraints:
//   1. (businessId, channel, externalId) — for external threads (externalId NOT NULL)
//   2. (businessId, partyId, channel) — for in_app (where externalId is NULL)
// This prevents the "multiple NULL externalId" problem that would allow
// duplicate in_app conversations.
//
// §UNREAD-COUNT: Derived from Message.isRead=false count, NOT maintained as a
// separate mutable counter. This avoids dual-source-of-truth issues. The
// unreadCount field is a denormalized cache that's updated transactionally
// when messages are created or marked read.
model Conversation {
  id              String    @id @default(cuid())
  businessId      String
  partyId         String    // the customer (NOT nullable — anonymous messages need a party first)
  channel         String    // whatsapp | telegram | messenger | instagram | sms | email | in_app
  externalId      String?   // provider's thread/chat ID (NULL for in_app)
  lastMessageAt   DateTime?
  lastMessagePreview String? // denormalized preview of last message body (first ~100 chars)
  unreadCount     Int       @default(0) // denormalized cache; derived from Message.isRead=false
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party           Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([businessId, channel, externalId]) // external thread uniqueness (externalId NOT NULL)
  // §IN_APP-UNIQUENESS: enforced via partial unique index in migration SQL
  // (Prisma cannot express WHERE clause on @@unique). The migration creates:
  //   CREATE UNIQUE INDEX "Conversation_businessId_partyId_in_app_key"
  //   ON "Conversation"("businessId", "partyId") WHERE "channel" = 'in_app';
  // Application-level dedup in POST /api/conversations also handles this.
  @@index([businessId, partyId])
  @@index([businessId, lastMessageAt])
  @@index([businessId, channel])
}

// §MESSAGE: Individual message in a conversation. Can be inbound (from customer),
// outbound (from staff), or internal_note (staff-only, not visible to customer).
//
// §IDEMPOTENCY: externalMessageId is the provider's message ID. The partial
// unique index @@unique([businessId, externalMessageId]) ensures that replaying
// the same webhook event does NOT create duplicate messages. For in_app messages
// (no externalMessageId), the field is NULL and PostgreSQL's NULL-distinctness
// means no conflict.
//
// §DIRECTION: inbound (customer → business), outbound (business → customer),
// internal_note (staff-only note, not sent to customer).
//
// §SENDER: senderType (customer | staff | system | bot) + senderId (free-form
// staff name or system identifier, consistent with PartyNote.author pattern).
model Message {
  id                String    @id @default(cuid())
  businessId        String
  conversationId    String
  partyId           String    // denormalized for efficient party-scoped queries
  channel           String    // denormalized from conversation
  direction         String    // inbound | outbound | internal_note
  senderType        String    // customer | staff | system | bot
  senderId          String?   // staff userId or external sender ID (free-form)
  body              String?
  attachments       String?   // JSON array of {name, type, dataUrl, size}
  externalMessageId String?   // provider's message ID (for webhook replay idempotency)
  isRead            Boolean   @default(false)
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  business          Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party             Party       @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([businessId, externalMessageId]) // idempotency for webhook replay
  @@index([conversationId, createdAt])
  @@index([businessId, partyId, createdAt])
  @@index([businessId, isRead])
}

// §CUSTOMER-REWARD-CYCLE: Persistent profit-based loyalty reward cycle.
// Each customer has a sequence of cycles. Only one ACTIVE cycle per customer.
// When accumulated profit reaches the threshold, the cycle becomes UNLOCKED.
// When the merchant gives the reward, the cycle becomes REWARDED and a new
// ACTIVE cycle is created.
//
// §CARRY-OVER SEMANTICS: When an invoice pushes accumulated profit past the
// threshold, the FULL invoice profit is attributed to the current cycle (which
// unlocks). The excess (accumulatedProfit - threshold) does NOT carry over to
// the next cycle — the next cycle starts at ₹0. This is the simpler, more common
// loyalty model: each cycle is independent, and the merchant's threshold defines
// the "cost" of a reward in terms of profit earned.
//
// §UNIQUENESS: (businessId, partyId, cycleNumber) is unique — cycle numbers
// are sequential per customer. Only one ACTIVE cycle per (businessId, partyId)
// is enforced via partial unique index in PostgreSQL (migration SQL).
//
// §THRESHOLD: Stored as a snapshot on the cycle at creation time (from
// AppSettings.rewardThreshold). This ensures historical cycles preserve
// the threshold that was in effect when they were created.
model CustomerRewardCycle {
  id                String   @id @default(cuid())
  businessId        String
  partyId           String
  cycleNumber       Int      @default(1)
  threshold         Decimal  @db.Decimal(18, 2) // snapshot from AppSettings at cycle creation
  accumulatedProfit Decimal  @default(0) @db.Decimal(18, 2)
  status            String   @default("ACTIVE") // ACTIVE | UNLOCKED | REWARDED
  startedAt         DateTime @default(now())
  unlockedAt        DateTime?
  rewardGivenAt     DateTime?
  rewardDescription String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party             Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  events            CustomerRewardEvent[]

  @@unique([businessId, partyId, cycleNumber])
  @@index([businessId, partyId, status])
  @@index([businessId, status])
}

// §CUSTOMER-REWARD-EVENT: Append-only audit trail for reward cycle events.
// Each event records a state transition or accrual. Events are immutable.
//
// §IDEMPOTENCY: (businessId, sourceInvoiceId) is unique — an invoice can
// only contribute profit ONCE per business. This prevents duplicate accrual
// from retries/concurrent requests. sourceInvoiceId is NULL for non-invoice
// events (REWARD_UNLOCKED, REWARD_GIVEN, CYCLE_RESET).
//
// §EVENT-TYPES: PROFIT_ACCRUAL (invoice contributes profit),
// REWARD_UNLOCKED (threshold reached), REWARD_GIVEN (merchant gives reward),
// CYCLE_RESET (new cycle created after reward).
model CustomerRewardEvent {
  id              String   @id @default(cuid())
  businessId      String
  partyId         String
  cycleId         String
  eventType       String   // PROFIT_ACCRUAL | REWARD_UNLOCKED | REWARD_GIVEN | CYCLE_RESET
  amount          Decimal  @default(0) @db.Decimal(18, 2) // profit amount for PROFIT_ACCRUAL
  sourceInvoiceId String?  // the invoice that contributed profit (for idempotency)
  note            String?
  createdAt       DateTime @default(now())

  cycle           CustomerRewardCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party           Party               @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([businessId, sourceInvoiceId]) // idempotency: invoice accrues once per business
  @@index([cycleId, createdAt])
  @@index([businessId, partyId, createdAt])
}
